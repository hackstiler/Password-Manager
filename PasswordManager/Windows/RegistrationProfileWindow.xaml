<Window x:Name="update" x:Class="PasswordManager.RegistrationProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PasswordManager"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="RegistrationProfileWindow" 
        Height="500" 
        Width="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent" LayoutUpdated="update_LayoutUpdated">
    <Grid MouseDown="Drag">


        <Border Background="#1a1a1a"
                CornerRadius="10"/>

        <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="375"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        
        <Border Height="40"
                Width="325"
                Background="#26272b"
                CornerRadius="10"
                Grid.Row="0">
            <TextBlock Text="Создание профиля"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       Foreground="#848484"/>

        </Border>

        <Border Height="375"
                Width="325"
                Background="#26272b"
                CornerRadius="10"
                Grid.Row="1">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                    <RowDefinition Height="75"/>
                </Grid.RowDefinitions>

                
                <!-- Имя профиля -->
                <TextBlock Text="Имя профиля*"
                           VerticalAlignment="Center"
                           FontSize="17"
                           Foreground="#848484"
                           Margin="15,0,15,35"
                           Grid.Row="0"/>
                <ui:TextBox Name="ProfileName_textbox"
                            Width="300"
                            Height="35"
                            Margin="0,30,0,0"
                            Grid.Row="0"
                            PlaceholderText="напишите имя профиля..."
                            FontSize="16"
                            Padding="10,5,0,0"/>

                <!-- адресс сайта -->
                <TextBlock Text="Адрес сайта"
                           VerticalAlignment="Center"
                           FontSize="17"
                           Foreground="#848484"
                           Margin="15,0,15,35"
                           Grid.Row="1"/>
                
                <ui:TextBox Name="websiteAdress_textbox"
                            Width="300"
                            Height="35"
                            Margin="0,30,0,0"
                            Grid.Row="1"
                            PlaceholderText="напишите адрес сайта..."
                            FontSize="16"
                            Padding="10,5,0,0"/>

                <!-- Логин -->
                <TextBlock Text="Логин*"
                           VerticalAlignment="Center"
                           FontSize="17"
                           Foreground="#848484"
                           Margin="15,0,15,35"
                           Grid.Row="2"/>
                <ui:TextBox Name="Login_textbox"
                            Width="300"
                            Height="35"
                            Margin="0,30,0,0"
                            Grid.Row="2"
                            PlaceholderText="напишите логин или почту..."
                            FontSize="16"
                            Padding="10,5,0,0"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль*"
                           VerticalAlignment="Center"
                           FontSize="17"
                           Foreground="#848484"
                           Margin="15,0,15,35"
                           Grid.Row="3"/>
                <ui:TextBox Name="Password_textbox"
                            Width="300"
                            Height="35"
                            Margin="0,30,0,0"
                            Grid.Row="3"
                            PlaceholderText="напишите пароль..."
                            FontSize="16"
                            Padding="10,5,0,0"/>

                <!-- Тип шифрования -->
                <TextBlock Text="Способ шифрования"
                           VerticalAlignment="Center"
                           FontSize="17"
                           Foreground="#848484"
                           Margin="15,0,15,35"
                           Grid.Row="4"/>
                <ComboBox Name="encryption_combobox"
                          Width="300"
                          Height="35"
                          Margin="0,30,0,0"
                          Grid.Row="4"
                          Padding="10,10,10,0"/>

            </Grid>
            
        </Border>

        <Border Height="40"
                Width="325"
                Grid.Row="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <ui:Button Name="Cancel_Btn"
                           Height="30"
                           Width="150"
                           Background="#26272b"
                           CornerRadius="10"
                           Foreground="#848484"
                           Content="отменить"
                           FontSize="12"
                           Grid.Column="0" Click="Cancel_Btn_Click"/>

                    <ui:Button Name="CreateProfile_Btn"
                           Height="30"
                           Width="150"
                           Background="#3c3bff"
                           CornerRadius="10"
                           Foreground="White"
                           Content="создать профиль"
                           FontSize="12"
                           Grid.Column="2" Click="CreateProfile_Btn_Click"/>

                </Grid>
            
            
            
            </Border>
        </Grid>

        <Rectangle x:Name="testr" Fill="Black" Visibility="Hidden"/>
        <Label Name="testl" Content="gg" VerticalAlignment="Center"
               HorizontalAlignment="Center" Visibility="Hidden"/>

    </Grid>
</Window>
